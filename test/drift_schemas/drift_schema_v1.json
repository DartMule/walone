        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"listening_sources\" (\"kind\" TEXT NOT NULL, \"source_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, PRIMARY KEY (\"kind\", \"source_id\"));"
        }
      ]
    },
    {
      "name": "source_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"source_days\" (\"day\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"source_id\" TEXT NOT NULL, \"listening_ms\" INTEGER NOT NULL, PRIMARY KEY (\"day\", \"kind\", \"source_id\"));"
        }
      ]
    },
    {
      "name": "statistics_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"statistics_preferences\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"collecting\" INTEGER NOT NULL DEFAULT 1 CHECK (\"collecting\" IN (0, 1)), \"goal_minutes\" INTEGER NOT NULL DEFAULT 30, \"key_goal\" INTEGER NULL, \"calendar_keys\" INTEGER NOT NULL DEFAULT 0 CHECK (\"calendar_keys\" IN (0, 1)), PRIMARY KEY (\"id\"));"
