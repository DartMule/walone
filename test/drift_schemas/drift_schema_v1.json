      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activity_days\" (\"day\" TEXT NOT NULL, \"listening_ms\" INTEGER NOT NULL DEFAULT 0, \"music_ms\" INTEGER NOT NULL DEFAULT 0, \"atmosphere_ms\" INTEGER NOT NULL DEFAULT 0, \"key_presses\" INTEGER NOT NULL DEFAULT 0, \"goal_minutes\" INTEGER NOT NULL, \"key_goal\" INTEGER NULL, PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
