  "fixed_sql": [
    {
      "name": "library_tracks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_tracks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"filename\" TEXT NOT NULL UNIQUE, \"duration\" REAL NOT NULL, \"source_id\" TEXT NULL, \"ordinal\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "library_artists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_artists\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE, \"ordinal\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "library_track_artists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_track_artists\" (\"track_id\" TEXT NOT NULL REFERENCES library_tracks (id) ON DELETE CASCADE, \"artist_id\" INTEGER NOT NULL REFERENCES library_artists (id) ON DELETE RESTRICT, \"ordinal\" INTEGER NOT NULL, PRIMARY KEY (\"track_id\", \"artist_id\"), UNIQUE (\"track_id\", \"ordinal\"));"
        }
      ]
    },
    {
      "name": "library_playlists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_playlists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"ordinal\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "library_playlist_tracks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_playlist_tracks\" (\"playlist_id\" TEXT NOT NULL REFERENCES library_playlists (id) ON DELETE CASCADE, \"track_id\" TEXT NOT NULL REFERENCES library_tracks (id) ON DELETE CASCADE, \"ordinal\" INTEGER NOT NULL, PRIMARY KEY (\"playlist_id\", \"track_id\"), UNIQUE (\"playlist_id\", \"ordinal\"));"
        }
      ]
    },
    {
      "name": "library_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"selected_id\" TEXT NULL, \"playing_id\" TEXT NULL, \"track_id\" TEXT NULL REFERENCES library_tracks (id) ON DELETE SET NULL, \"position\" REAL NOT NULL, \"volume\" REAL NOT NULL, \"shuffle\" INTEGER NOT NULL CHECK (\"shuffle\" IN (0, 1)), \"repeat_mode\" TEXT NOT NULL, \"import_limit\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "track_artists_by_artist",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX track_artists_by_artist ON library_track_artists (artist_id)"
        }
      ]
    },
    {
      "name": "playlist_tracks_by_track",
      "sql": [
        {
